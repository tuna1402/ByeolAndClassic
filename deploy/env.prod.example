DJANGO_ENV=prod
DEBUG=0
SECRET_KEY=replace-with-a-real-secret-key
ALLOWED_HOSTS=yourusername.pythonanywhere.com,example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com,https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=ByeolAndClassic
BREVO_ADMIN_EMAIL=admin@example.com
CONTACT_TO_EMAIL=admin@example.com
CONTACT_FROM_EMAIL=no-reply@example.com
